rules_version = '2';

// Nur die (höchstens zwei) Mitglieder eines Haushalts sehen dessen Daten.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Private Gesundheitseinträge: nur für die Person selbst.
      match /health/{entryId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Einladungscodes: einzeln abrufbar, aber nicht auflistbar.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    // Alexa verbinden: Die App legt einen kurzlebigen Code für den eigenen
    // Haushalt an. Lesen und einlösen kann ihn nur die Cloud Function.
    match /alexaCodes/{code} {
      allow create: if signedIn() &&
        code.matches('[0-9]{6}') &&
        request.resource.data.keys().hasOnly(['uid', 'householdId', 'expiresAt']) &&
        request.resource.data.uid == request.auth.uid &&
        isMember(request.resource.data.householdId) &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt < request.time + duration.value(20, 'm');
    }

    // Verbundene Amazon-Konten: jede Person sieht und trennt nur ihre eigenen.
    match /alexaLinks/{alexaUser} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];

      // Mitglieder dürfen den Namen ändern, aber nicht die Mitgliederliste.
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'inviteCode']);

      // Beitreten: sich selbst als zweites Mitglied eintragen, sonst nichts.
      allow update: if signedIn() &&
        !(request.auth.uid in resource.data.members) &&
        resource.data.members.size() == 1 &&
        request.resource.data.members == resource.data.members.concat([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames']);

      // Standort: beide dürfen lesen, aber jede Person nur ihren eigenen schreiben.
      match /locations/{uid} {
        allow read: if isMember(householdId);
        allow write: if isMember(householdId) && request.auth.uid == uid;
      }

      // Pflanzenfotos liegen verkleinert direkt im Dokument (max. 1 MB).
      match /plantPhotos/{photoId} {
        allow read, delete: if isMember(householdId);
        allow create, update: if isMember(householdId) &&
          request.resource.data.plantId is string &&
          request.resource.data.image is bytes &&
          request.resource.data.image.size() <= 950000;
      }

      match /{collection}/{docId} {
        allow read, write: if !(collection in ['locations', 'plantPhotos']) &&
          isMember(householdId);
      }
    }
  }
}
